{
  "entities": {
    "User": {
      "title": "User",
      "description": "Thông tin tài khoản khách hàng, bác sĩ, đại lý và quản trị viên TECNIC",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "accountType": { "type": "string" },
        "clinicName": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "fullName", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Đơn đặt hàng thiết bị y tế TECNIC MEDTECH",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderCode": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "totalTecnicPrice": { "type": "number" },
        "finalTotal": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "orderStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderCode", "customerName", "customerPhone", "finalTotal"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Lưu trữ hồ sơ tài khoản người dùng đăng nhập bằng Google, Facebook hoặc tài khoản hệ thống"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Lưu trữ đơn hàng khách đặt trực tuyến"
    }
  }
}
